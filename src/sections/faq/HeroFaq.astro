---
import { getImage } from "astro:assets";
import heroImage from "../../assets/images/faq/faq.png";
import HeroInterno from "../../components/shared/HeroInterno.astro";
import { rutas } from "../../config/site";

const heroImageOptimizada = await getImage({
  src: heroImage,
  width: 1800,
  format: "webp",
  quality: 76,
});
---

<HeroInterno
  imageSrc={heroImageOptimizada.src}
  imageAlt="Espacio de trabajo de Presentar By H&B SAS"
  eyebrow="Preguntas frecuentes"
  titulo="Resolvemos sus principales inquietudes"
  descripcion="Encuentre información general sobre nuestros servicios, el proceso de atención y la forma de trabajar con Presentar By H&B SAS."
  ctaLabel="Agendar una cita"
  ctaHref={rutas.contacto}
/>
