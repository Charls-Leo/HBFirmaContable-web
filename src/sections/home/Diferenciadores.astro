---
import { atributos } from "../../data/atributos";
import Icono from "../../components/shared/Icono.astro";

const destacados = atributos.slice(0, 4);

const descripciones = [
  "Escuchamos y nos adaptamos a la realidad de cada persona o negocio.",
  "Traducimos términos técnicos en información comprensible.",
  "Cuidamos la reserva y el manejo de cada soporte recibido.",
  "Cumplimos con procesos claros, fechas y seguimiento.",
];
---

<section class="section differentiators" aria-labelledby="diferenciadores-title">
  <div class="container differentiators__layout">
    <div class="differentiators__copy reveal">
      <span class="eyebrow">Por qué elegirnos</span>
      <h2 class="heading" id="diferenciadores-title">Una firma que acompaña, organiza y orienta</h2>
      <p class="differentiators__lead">
        Trabajamos con cercanía, claridad y responsabilidad para convertir la información contable en una herramienta útil para cada cliente.
      </p>
    </div>
    <div class="differentiators__cards stagger">
      {
        destacados.map((item, index) => (
          <article class="differentiators__card reveal reveal--scale">
            <div class="differentiators__card-top">
              <span class="differentiators__icon">
                <Icono name={item.icono} />
              </span>
              <span class="differentiators__index">0{index + 1}</span>
            </div>
            <h3>{item.titulo}</h3>
            <p>{descripciones[index]}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .differentiators {
    background: var(--color-navy);
    color: var(--color-white);
  }

  .differentiators__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }

  .differentiators__copy {
    max-width: 26rem;
  }

  .heading {
    margin: 1rem 0 0;
    font-size: var(--tamano-3xl);
  }

  .differentiators__lead {
    margin: 1.5rem 0 0;
    border-left: 2px solid rgba(191, 145, 73, 0.5);
    padding-left: 1.25rem;
    color: rgba(255, 255, 255, 0.66);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.75;
  }

  .differentiators__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .differentiators__card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border: 1px solid rgba(191, 145, 73, 0.16);
    border-radius: 0.875rem;
    background: var(--color-navy-soft);
    padding: 1.85rem;
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 280ms ease,
      background-color 280ms ease;
  }

  .differentiators__card:hover {
    transform: translateY(-6px);
    border-color: rgba(191, 145, 73, 0.5);
    background: color-mix(in srgb, var(--color-navy-soft) 82%, white);
  }

  .differentiators__card.reveal.reveal--scale.is-visible:hover {
    transform: translateY(-6px) scale(1);
  }

  .differentiators__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .differentiators__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 0.65rem;
    background: rgba(191, 145, 73, 0.14);
    color: var(--color-gold);
  }

  .differentiators__icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .differentiators__index {
    color: rgba(211, 172, 114, 0.55);
    font-family: var(--font-heading);
    font-size: 1rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    line-height: 1.15;
  }

  .differentiators__card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.65;
  }

  @media (max-width: 960px) {
    .differentiators__layout {
      grid-template-columns: 1fr;
    }

    .differentiators__copy {
      max-width: 34rem;
    }
  }

  @media (max-width: 520px) {
    .differentiators__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
