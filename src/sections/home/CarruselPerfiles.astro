---
import { perfiles } from "../../data/perfiles";
import TituloSeccion from "../../components/shared/TituloSeccion.astro";
import TarjetaServicio from "../../components/shared/TarjetaServicio.astro";
import Icono from "../../components/shared/Icono.astro";
---

<section class="section profiles" aria-labelledby="perfiles-title">
  <div class="container">
    <div class="profiles__top">
      <TituloSeccion
        ceja="Perfiles que acompañamos"
        titulo="Negocios y personas que podemos acompañar"
        align="left"
        tone="light"
      />
      <div class="profiles__controls" aria-label="Controles del carrusel">
        <button type="button" aria-label="Ver perfiles anteriores" data-profile-prev>
          <Icono name="arrowLeft" />
        </button>
        <button type="button" aria-label="Ver perfiles siguientes" data-profile-next>
          <Icono name="arrowRight" />
        </button>
      </div>
    </div>

    <div class="profiles__carousel reveal" data-profile-carousel tabindex="0" aria-label="Carrusel de perfiles">
      {
        perfiles.map((perfil) => (
          <TarjetaServicio dark {...perfil} />
        ))
      }
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector("[data-profile-carousel]");
  const prev = document.querySelector("[data-profile-prev]");
  const next = document.querySelector("[data-profile-next]");

  const getStep = () => {
    const card = carousel?.querySelector("a, article");
    if (!card) return 320;
    const rect = card.getBoundingClientRect();
    return rect.width + 18;
  };

  prev?.addEventListener("click", () => {
    carousel?.scrollBy({ left: -getStep(), behavior: "smooth" });
  });

  next?.addEventListener("click", () => {
    carousel?.scrollBy({ left: getStep(), behavior: "smooth" });
  });
</script>

<style>
  .profiles {
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-white);
  }

  .profiles__top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .profiles__top :global(.section-title) {
    margin-bottom: 2.4rem;
  }

  .profiles__controls {
    display: flex;
    gap: 0.7rem;
    margin-bottom: 2.4rem;
  }

  button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-white);
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      transform 220ms ease;
  }

  button:hover {
    transform: translateY(-2px);
    border-color: rgba(191, 145, 73, 0.55);
    background: rgba(191, 145, 73, 0.16);
  }

  button :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .profiles__carousel {
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    margin-top: -0.65rem;
    padding: 0.85rem 0 1rem;
    scroll-padding-inline: 1rem;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--color-gold) rgba(255, 255, 255, 0.12);
  }

  .profiles__carousel :global(.service-card) {
    flex: 0 0 clamp(15rem, 40vw, 18rem);
    scroll-snap-align: start;
  }

  @media (max-width: 700px) {
    .profiles__top {
      display: block;
    }

    .profiles__controls {
      margin-bottom: 1.2rem;
    }
  }
</style>
