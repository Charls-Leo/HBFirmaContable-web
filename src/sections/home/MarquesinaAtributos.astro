---
import { atributos } from "../../data/atributos";
import Icono from "../../components/shared/Icono.astro";

const items = [...atributos, ...atributos];
---

<section class="marquee reveal reveal--fade" aria-label="Atributos de la firma">
  <div class="marquee__track">
    {
      items.map((item) => (
        <div class="marquee__item">
          <Icono name={item.icono} />
          <span>{item.titulo}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(7, 21, 47, 0.05);
    background: var(--color-ivory);
    padding-block: 2.5rem;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    min-width: 200%;
    gap: clamp(2rem, 5vw, 3.5rem);
    animation: marquee-left 34s linear infinite;
  }

  .marquee__item {
    display: flex;
    min-width: max-content;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-navy);
  }

  .marquee__item :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-gold);
  }

  span {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      width: auto;
      min-width: 0;
      flex-wrap: wrap;
      justify-content: center;
      animation: none;
    }
  }
</style>
