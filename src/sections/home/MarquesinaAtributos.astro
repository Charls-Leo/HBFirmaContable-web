---
import { atributos } from "../../data/atributos";
import Icono from "../../components/shared/Icono.astro";

const items = [...atributos, ...atributos];
---

<section class="marquee" aria-label="Atributos de la firma">
  <div class="marquee__track" data-marquee-track tabindex="0">
    {
      items.map((item) => (
        <div class="marquee__item">
          <Icono name={item.icono} />
          <span>{item.titulo}</span>
        </div>
      ))
    }
  </div>
  <button type="button" class="marquee__toggle" data-marquee-toggle aria-pressed="false">
    Pausar animación
  </button>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-marquee-track]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-marquee-toggle]");

  toggle?.addEventListener("click", () => {
    const isPaused = track?.classList.toggle("is-paused");
    toggle.setAttribute("aria-pressed", String(Boolean(isPaused)));
    toggle.textContent = isPaused ? "Reanudar animación" : "Pausar animación";
  });
</script>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(7, 21, 47, 0.05);
    background: var(--color-ivory);
    padding-block: 2.5rem;
  }

  .marquee__toggle {
    position: absolute;
    right: 1.25rem;
    bottom: 0.4rem;
    z-index: 1;
    border: none;
    background: none;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
    font-family: var(--font-body);
    font-size: 0.8125rem;
  }

  .marquee__toggle:hover {
    color: var(--color-gold);
  }

  .marquee__track.is-paused {
    animation-play-state: paused;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    min-width: 200%;
    gap: clamp(2rem, 5vw, 3.5rem);
    animation: marquee-left 34s linear infinite;
  }

  .marquee__track:hover,
  .marquee__track:focus-visible {
    animation-play-state: paused;
  }

  .marquee__item {
    display: flex;
    min-width: max-content;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-navy);
  }

  .marquee__item :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-gold);
  }

  span {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      width: auto;
      min-width: 0;
      flex-wrap: wrap;
      justify-content: center;
      animation: none;
    }
  }
</style>
