---
import { servicios } from "../../data/servicios";
import TituloSeccion from "../../components/shared/TituloSeccion.astro";
import TarjetaServicio from "../../components/shared/TarjetaServicio.astro";
import Boton from "../../components/shared/Boton.astro";
import { rutas } from "../../config/site";
---

<section class="section services" id="servicios" aria-labelledby="servicios-title">
  <div class="container">
    <TituloSeccion
      ceja="Servicios"
      titulo="Servicios pensados para necesidades reales"
      descripcion="No creemos en soluciones genéricas. Nuestro enfoque se basa en el acompañamiento personalizado para que su gestión contable, tributaria y financiera esté siempre alineada con sus objetivos."
    />
    <div class="services__grid stagger">
      {
        servicios.map(({ id, href, tituloFooter, ...servicio }) => (
          <TarjetaServicio class="reveal reveal--scale" {...servicio} />
        ))
      }
    </div>
    <div class="services__actions reveal">
      <Boton href={rutas.servicios}>Conocer todos nuestros servicios</Boton>
    </div>
  </div>
</section>

<style>
  .services {
    background: color-mix(in srgb, var(--color-ivory) 72%, white);
  }

  .services :global(.section-title) {
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .services :global(.lead) {
    margin-top: 0.9rem;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.35rem);
  }

  .services__actions {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  @media (max-width: 920px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
