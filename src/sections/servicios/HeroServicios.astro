---
import { getImage } from "astro:assets";
import heroImage from "../../assets/images/servicios/servicios.png";
import HeroInterno from "../../components/shared/HeroInterno.astro";
import { rutas } from "../../config/site";

const heroImageOptimizada = await getImage({
  src: heroImage,
  width: 1800,
  format: "webp",
  quality: 76,
});
---

<HeroInterno
  imageSrc={heroImageOptimizada.src}
  imageAlt="Equipo de Presentar By H&B SAS trabajando en soluciones contables para clientes"
  eyebrow="Servicios"
  titulo="Soluciones contables para personas, negocios y empresas"
  descripcion="Acompañamos a cada cliente de acuerdo con sus necesidades contables, tributarias, laborales y financieras, con un enfoque en la claridad y la precisión."
  ctaLabel="Agendar una cita"
  ctaHref={rutas.contacto}
/>
