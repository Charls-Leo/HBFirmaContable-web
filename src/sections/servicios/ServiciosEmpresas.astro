---
import { getImage } from "astro:assets";
import { serviciosEmpresas } from "../../data/serviciosEmpresas";
import TituloSeccion from "../../components/shared/TituloSeccion.astro";
import Icono from "../../components/shared/Icono.astro";
import logoBloque from "../../assets/images/brand/logoblancobloque.png";

const logoBloqueOptimizado = await getImage({
  src: logoBloque,
  width: 220,
  format: "webp",
  quality: 84,
});

const angulos = [-90, -30, 30, 90, 150, 210];
const items = serviciosEmpresas.map((servicio, index) => ({
  ...servicio,
  angulo: angulos[index],
}));
---

<section class="section servicios-empresas" aria-labelledby="servicios-empresas-title">
  <div class="container">
    <TituloSeccion
      id="servicios-empresas-title"
      ceja="Servicios para empresas"
      titulo="Servicios para negocios y empresas"
      descripcion="Seis frentes de trabajo organizados alrededor de un mismo propósito: la salud contable y financiera de su empresa."
    />

    <div class="orbit reveal reveal--scale" aria-hidden="true">
      <div class="orbit__ring"></div>
      <div class="orbit__hub">
        <img src={logoBloqueOptimizado.src} alt="" />
      </div>
      {
        items.map((item, index) => (
          <span class="orbit__spoke" style={`--angle: ${item.angulo}deg`} />
        ))
      }
      {
        items.map((item, index) => (
          <div class="orbit__item" style={`--angle: ${item.angulo}deg; --i: ${index}`}>
            <span class="orbit__node">
              <Icono name={item.icono} />
            </span>
            <h3>{item.titulo}</h3>
            <p>{item.descripcion}</p>
          </div>
        ))
      }
    </div>

    <ul class="servicios-empresas__list stagger">
      {
        items.map((item) => (
          <li class="reveal reveal--scale">
            <span class="servicios-empresas__list-icon">
              <Icono name={item.icono} />
            </span>
            <div>
              <h3>{item.titulo}</h3>
              <p>{item.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .servicios-empresas {
    background: var(--color-white);
  }

  .servicios-empresas :global(.section-title) {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .servicios-empresas :global(.lead) {
    margin-top: 0.9rem;
  }

  /* ---- Radial composition (wide desktop only) ---- */

  .orbit {
    position: relative;
    display: none;
    width: 38rem;
    height: 38rem;
    margin: 0 auto;
  }

  .orbit__ring {
    position: absolute;
    inset: 3rem;
    border: 1px dashed rgba(191, 145, 73, 0.28);
    border-radius: 999px;
  }

  .orbit__hub {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    overflow: hidden;
    width: 8rem;
    height: 8rem;
    place-items: center;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: var(--color-navy);
    box-shadow: 0 24px 54px rgba(7, 21, 47, 0.24);
  }

  .orbit__hub img {
    width: 3.1rem;
    height: auto;
  }

  .orbit__spoke {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11.2rem;
    height: 1px;
    background: linear-gradient(to right, rgba(191, 145, 73, 0.55), rgba(191, 145, 73, 0));
    transform-origin: left center;
    transform: rotate(var(--angle));
  }

  .orbit__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10.5rem;
    text-align: center;
    transform: translate(-50%, -50%) rotate(var(--angle)) translate(14.5rem, 0) rotate(calc(var(--angle) * -1));
    opacity: 0;
    transition:
      opacity 620ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 90ms + 200ms);
  }

  .orbit.is-visible .orbit__item {
    opacity: 1;
  }

  .orbit__node {
    display: grid;
    overflow: hidden;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 0.75rem;
    place-items: center;
    border: 1px solid rgba(191, 145, 73, 0.32);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-gold);
    box-shadow: 0 12px 28px rgba(191, 145, 73, 0.14);
  }

  .orbit__node :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
  }

  .orbit__item h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1.2;
  }

  .orbit__item p {
    margin: 0;
    color: color-mix(in srgb, var(--color-navy) 62%, transparent);
    font-size: 0.8125rem;
    font-weight: 300;
    line-height: 1.5;
  }

  /* ---- Connected list (default / tablet / mobile) ---- */

  .servicios-empresas__list {
    position: relative;
    display: grid;
    gap: 1.1rem;
    max-width: 40rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .servicios-empresas__list::before {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 1.6rem;
    width: 1px;
    background: rgba(191, 145, 73, 0.25);
    content: "";
  }

  .servicios-empresas__list li {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .servicios-empresas__list-icon {
    display: grid;
    overflow: hidden;
    width: 3.5rem;
    height: 3.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(191, 145, 73, 0.32);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-gold);
    box-shadow: 0 12px 28px rgba(191, 145, 73, 0.12);
  }

  .servicios-empresas__list-icon :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
  }

  .servicios-empresas__list h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    line-height: 1.15;
  }

  .servicios-empresas__list p {
    margin: 0;
    color: color-mix(in srgb, var(--color-navy) 68%, transparent);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.65;
  }

  @media (min-width: 1100px) {
    .orbit {
      display: block;
    }

    .servicios-empresas__list {
      display: none;
    }
  }
</style>
