---
import { getImage } from "astro:assets";
import kellyImage from "../../assets/images/nosotros/foto-kelly.jpeg";

const kellyImageOptimizada = await getImage({
  src: kellyImage,
  width: 720,
  format: "webp",
  quality: 82,
});
---

<section class="section liderazgo" aria-labelledby="liderazgo-title">
  <div class="container liderazgo__grid">
    <div class="liderazgo__copy">
      <span class="eyebrow reveal">Visión de liderazgo</span>
      <h2 class="heading reveal" id="liderazgo-title">Estructura y sentido humano en cada balance</h2>
      <blockquote class="liderazgo__quote reveal">
        "Cada cifra debe convertirse en información útil para quien toma las decisiones. No se trata solo de cumplir, sino de entender."
      </blockquote>
      <p class="reveal">
        Bajo la dirección de Kelly Hernández Barahona, Presentar By H&B SAS ha consolidado un método de trabajo donde la precisión técnica se une con una comunicación empática. Nuestra meta es que el cliente se sienta respaldado y seguro de que su información está en las manos correctas.
      </p>
    </div>
    <div class="liderazgo__media reveal reveal--image">
      <div class="liderazgo__panel">
        <img
          class="liderazgo__photo"
          src={kellyImageOptimizada.src}
          alt="Kelly Hernández Barahona, directora general de Presentar By H&B SAS"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="liderazgo__tag">
        <strong>Kelly Hernández B.</strong>
        <span>Directora general</span>
      </div>
    </div>
  </div>
</section>

<style>
  .liderazgo {
    background: color-mix(in srgb, var(--color-ivory) 72%, white);
  }

  .liderazgo__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(3rem, 6vw, 5.5rem);
    align-items: center;
  }

  .liderazgo__copy {
    max-width: 32rem;
  }

  .heading {
    margin: 1rem 0 1.5rem;
    font-size: var(--tamano-3xl);
  }

  .liderazgo__quote {
    margin: 0 0 1.5rem;
    border-left: 2px solid rgba(191, 145, 73, 0.5);
    padding-left: 1.25rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.6;
  }

  .liderazgo__copy p {
    margin: 0;
    color: color-mix(in srgb, var(--color-navy) 64%, transparent);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.72;
  }

  .liderazgo__copy > .reveal:nth-child(1) {
    transition-delay: 0ms;
  }

  .liderazgo__copy > .reveal:nth-child(2) {
    transition-delay: 100ms;
  }

  .liderazgo__copy > .reveal:nth-child(3) {
    transition-delay: 200ms;
  }

  .liderazgo__copy > .reveal:nth-child(4) {
    transition-delay: 300ms;
  }

  .liderazgo__media {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
  }

  .liderazgo__panel {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    background: var(--color-navy);
    box-shadow: 0 24px 54px rgba(7, 21, 47, 0.2);
  }

  .liderazgo__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1.01);
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .liderazgo__media:hover .liderazgo__photo {
    transform: scale(1.055);
  }

  .liderazgo__tag {
    position: absolute;
    bottom: -1.1rem;
    left: 1.5rem;
    display: grid;
    gap: 0.15rem;
    border-radius: 0.7rem;
    background: var(--color-white);
    padding: 0.85rem 1.2rem;
    box-shadow: 0 16px 34px rgba(7, 21, 47, 0.16);
  }

  .liderazgo__tag strong {
    color: var(--color-navy);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .liderazgo__tag span {
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .liderazgo__grid {
      grid-template-columns: 1fr;
    }

    .liderazgo__copy {
      max-width: none;
    }

    .liderazgo__media {
      margin-bottom: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .liderazgo__photo {
      transform: none;
      transition: none;
    }

    .liderazgo__media:hover .liderazgo__photo {
      transform: none;
    }
  }
</style>
