---
import { getImage } from "astro:assets";
import heroImage from "../../assets/images/nosotros/nosotros1.png";
import HeroInterno from "../../components/shared/HeroInterno.astro";
import { rutas } from "../../config/site";

const heroImageOptimizada = await getImage({
  src: heroImage,
  width: 1800,
  format: "webp",
  quality: 76,
});
---

<HeroInterno
  imageSrc={heroImageOptimizada.src}
  imageAlt="Equipo de Presentar By H&B SAS en su oficina"
  eyebrow="Nosotros"
  titulo="Una firma cercana para decisiones más claras"
  descripcion="En Presentar By H&B SAS acompañamos a empresas, negocios, emprendedores y personas naturales en la organización y comprensión de su información contable, tributaria, laboral y financiera."
  ctaLabel="Agendar una cita"
  ctaHref={rutas.contacto}
/>
