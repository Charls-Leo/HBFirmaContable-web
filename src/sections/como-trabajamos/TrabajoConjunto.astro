---
import Icono from "../../components/shared/Icono.astro";

const compromiso = [
  "Orientar el proceso con claridad",
  "Manejar la información con responsabilidad",
  "Informar los requerimientos y avances",
  "Resolver inquietudes",
];

const participacion = [
  "Entregar información completa y oportuna",
  "Informar cambios importantes",
  "Revisar comunicaciones",
  "Cumplir acuerdos",
];
---

<section class="section trabajo-conjunto" aria-labelledby="trabajo-conjunto-title">
  <div class="container">
    <h2 class="visually-hidden" id="trabajo-conjunto-title">Nuestro compromiso y su participación</h2>
    <div class="trabajo-conjunto__grid">
      <div class="trabajo-conjunto__col reveal">
        <span class="eyebrow">Nuestro compromiso</span>
        <h3>Lo que usted puede esperar de nosotros</h3>
        <ul class="stagger">
          {
            compromiso.map((item) => (
              <li class="reveal">
                <Icono name="check" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="trabajo-conjunto__divider" aria-hidden="true"></div>
      <div class="trabajo-conjunto__col reveal reveal--left">
        <span class="eyebrow">Su participación</span>
        <h3>Lo que necesitamos de su parte</h3>
        <ul class="stagger">
          {
            participacion.map((item) => (
              <li class="reveal">
                <Icono name="userPlus" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .trabajo-conjunto {
    background: color-mix(in srgb, var(--color-ivory) 72%, white);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .trabajo-conjunto__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .trabajo-conjunto__divider {
    width: 1px;
    background: rgba(7, 21, 47, 0.1);
  }

  .trabajo-conjunto__col h3 {
    max-width: 20rem;
    margin: 0.6rem 0 1.5rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .trabajo-conjunto__col ul {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trabajo-conjunto__col li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-navy);
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .trabajo-conjunto__col :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    color: var(--color-gold);
  }

  @media (max-width: 760px) {
    .trabajo-conjunto__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .trabajo-conjunto__divider {
      width: 100%;
      height: 1px;
    }
  }
</style>
