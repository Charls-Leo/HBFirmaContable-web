---
import TituloSeccion from "../../components/shared/TituloSeccion.astro";

const pasos = [
  "Nos cuenta cuál es su necesidad",
  "Revisamos la información inicial",
  "Identificamos el servicio adecuado",
  "Presentamos una propuesta",
  "Acordamos la forma de trabajo",
  "Iniciamos el acompañamiento",
];
---

<section class="section despues-cita" aria-labelledby="despues-cita-title">
  <div class="container">
    <TituloSeccion
      id="despues-cita-title"
      ceja="Primeros pasos"
      titulo="¿Qué sucede después de solicitar una cita?"
    />
    <ol class="despues-cita__grid">
      {
        pasos.map((paso, index) => (
          <li class="despues-cita__item reveal">
            <span class="despues-cita__numero">0{index + 1}</span>
            <span class="despues-cita__titulo">{paso}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .despues-cita {
    background: var(--color-white);
  }

  .despues-cita__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .despues-cita__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-radius: 0.875rem;
    background: var(--color-ivory);
    padding: 1.35rem 1.5rem;
  }

  .despues-cita__numero {
    flex: 0 0 auto;
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 1.375rem;
  }

  .despues-cita__titulo {
    color: var(--color-navy);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .despues-cita__item:nth-child(1) {
    transition-delay: 0ms;
  }

  .despues-cita__item:nth-child(2) {
    transition-delay: 110ms;
  }

  .despues-cita__item:nth-child(3) {
    transition-delay: 220ms;
  }

  .despues-cita__item:nth-child(4) {
    transition-delay: 330ms;
  }

  .despues-cita__item:nth-child(5) {
    transition-delay: 440ms;
  }

  .despues-cita__item:nth-child(6) {
    transition-delay: 550ms;
  }

  @media (max-width: 920px) {
    .despues-cita__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .despues-cita__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
