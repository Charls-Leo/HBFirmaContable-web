---
import { proceso } from "../../data/proceso";
import TituloSeccion from "../../components/shared/TituloSeccion.astro";
import Icono from "../../components/shared/Icono.astro";
---

<section class="section metodologia" aria-labelledby="metodologia-title">
  <div class="container">
    <TituloSeccion id="metodologia-title" ceja="Metodología" titulo="Nuestra metodología de trabajo" />

    <div class="metodologia__flow reveal">
      <div class="metodologia__rail" aria-hidden="true">
        <span class="metodologia__rail-base"></span>
        <span class="metodologia__rail-progress"></span>
      </div>
      <ol class="metodologia__steps">
        {
          proceso.map((paso, index) => (
            <li class="metodologia__step reveal reveal--right">
              <span class="metodologia__marcador">
                <Icono name={paso.icono} />
              </span>
              <div class="metodologia__panel">
                <span class="metodologia__numero">0{index + 1}</span>
                <h3>{paso.titulo}</h3>
                <p>{paso.descripcion}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .metodologia {
    background: color-mix(in srgb, var(--color-ivory) 72%, white);
  }

  .metodologia :global(.section-title) {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .metodologia__flow {
    position: relative;
    max-width: 42rem;
    margin-inline: auto;
  }

  .metodologia__rail {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    width: 2px;
  }

  .metodologia__rail-base {
    position: absolute;
    inset: 0;
    background: rgba(191, 145, 73, 0.22);
    opacity: 0;
    transition: opacity 500ms ease 120ms;
  }

  .metodologia__flow.is-visible .metodologia__rail-base {
    opacity: 1;
  }

  .metodologia__rail-progress {
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    transform: scaleY(0);
    transform-origin: top;
  }

  .metodologia__flow.is-visible .metodologia__rail-progress {
    animation: metodologia-fill 1.3s cubic-bezier(0.16, 1, 0.3, 1) 220ms forwards;
  }

  .metodologia__steps {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .metodologia__step {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .metodologia__step:nth-child(1) {
    transition-delay: 120ms;
  }

  .metodologia__step:nth-child(2) {
    transition-delay: 260ms;
  }

  .metodologia__step:nth-child(3) {
    transition-delay: 400ms;
  }

  .metodologia__step:nth-child(4) {
    transition-delay: 540ms;
  }

  .metodologia__marcador {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 999px;
    background: var(--color-navy);
    color: var(--color-gold);
    box-shadow: 0 12px 28px rgba(7, 21, 47, 0.18);
  }

  .metodologia__marcador :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .metodologia__panel {
    flex: 1;
    border: 1px solid rgba(7, 21, 47, 0.08);
    border-radius: 0.875rem;
    background: var(--color-white);
    padding: 1.25rem 1.5rem;
    box-shadow: 0 1px 0 rgba(7, 21, 47, 0.03);
  }

  .metodologia__numero {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
  }

  .metodologia__panel h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
  }

  .metodologia__panel p {
    margin: 0;
    color: color-mix(in srgb, var(--color-navy) 62%, transparent);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.6;
  }

  @media (max-width: 620px) {
    .metodologia__steps {
      gap: 1.5rem;
    }

    .metodologia__step {
      gap: 1rem;
    }

    .metodologia__marcador {
      width: 2.5rem;
      height: 2.5rem;
    }

    .metodologia__marcador :global(svg) {
      width: 1.1rem;
      height: 1.1rem;
    }

    .metodologia__panel {
      padding: 1rem 1.15rem;
    }

    .metodologia__rail {
      left: 1.25rem;
    }
  }

  @keyframes metodologia-fill {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }
</style>
