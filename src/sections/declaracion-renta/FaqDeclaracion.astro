---
import { preguntasFrecuentes } from "../../data/preguntasFrecuentes";
import TituloSeccion from "../../components/shared/TituloSeccion.astro";
import AcordeonItem from "../../components/shared/AcordeonItem.astro";

const destacadas = preguntasFrecuentes.filter((item) => item.declaracionPreview);
---

<section class="section faq-renta" aria-labelledby="faq-renta-title">
  <div class="container faq-renta__inner">
    <TituloSeccion
      id="faq-renta-title"
      ceja="Dudas frecuentes"
      titulo="Preguntas frecuentes"
    />
    <div class="faq-renta__list">
      {
        destacadas.map((item, index) => (
          <AcordeonItem
            pregunta={item.pregunta}
            respuesta={item.respuesta}
            mostrarEnlace
            class="reveal"
            style={`transition-delay: ${index * 90}ms`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-renta {
    background: color-mix(in srgb, var(--color-ivory) 72%, white);
  }

  .faq-renta__inner {
    max-width: 56rem;
  }

  .faq-renta__list {
    display: grid;
    gap: 0.85rem;
  }
</style>
