---
import Boton from "./Boton.astro";

interface Props {
  imageSrc: string;
  imageAlt: string;
  eyebrow: string;
  titulo: string;
  descripcion: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaSecundarioLabel?: string;
  ctaSecundarioHref?: string;
}

const {
  imageSrc,
  imageAlt,
  eyebrow,
  titulo,
  descripcion,
  ctaLabel,
  ctaHref,
  ctaSecundarioLabel,
  ctaSecundarioHref,
} = Astro.props;
---

<section class="hero-interno" aria-labelledby="hero-interno-title">
  <img class="hero-interno__image" src={imageSrc} alt={imageAlt} loading="eager" decoding="async" />
  <div class="hero-interno__overlay"></div>
  <div class="hero-interno__content">
    <div class="hero-interno__copy">
      <span class="hero-interno__eyebrow">{eyebrow}</span>
      <h1 class="hero-interno__title" id="hero-interno-title">{titulo}</h1>
      <p>{descripcion}</p>
      {(ctaLabel || ctaSecundarioLabel) && (
        <div class="hero-interno__actions">
          {ctaLabel && ctaHref && (
            <Boton href={ctaHref} size="lg" class="hero-interno__cta">
              {ctaLabel}
            </Boton>
          )}
          {ctaSecundarioLabel && ctaSecundarioHref && (
            <Boton href={ctaSecundarioHref} variant="outline" size="lg" class="hero-interno__cta">
              {ctaSecundarioLabel}
            </Boton>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-interno {
    position: relative;
    display: flex;
    min-height: 32rem;
    align-items: center;
    overflow: hidden;
    background: #080e1c;
    color: #fbf9f5;
    padding-top: 5.4rem;
  }

  .hero-interno__image,
  .hero-interno__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-interno__image {
    object-fit: cover;
    object-position: center center;
    opacity: 0.96;
    transform: scale(1.015);
    animation: hero-interno-settle 1800ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-interno__overlay {
    background:
      linear-gradient(
        90deg,
        rgba(8, 14, 28, 0.94) 0%,
        rgba(8, 14, 28, 0.86) 38%,
        rgba(10, 18, 36, 0.66) 68%,
        rgba(10, 18, 36, 0.58) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 14, 28, 0.28) 0%,
        rgba(8, 14, 28, 0.14) 48%,
        rgba(8, 14, 28, 0.4) 100%
      );
  }

  .hero-interno__content {
    position: relative;
    z-index: 1;
    width: min(1280px, 100%);
    margin-inline: auto;
    padding: 3rem clamp(1.25rem, 4vw, 2.5rem);
  }

  .hero-interno__copy {
    display: grid;
    width: min(100%, 38rem);
    gap: 1.25rem;
  }

  .hero-interno__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: #d3ac72;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    animation: hero-interno-item-in 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 120ms;
  }

  .hero-interno__eyebrow::before {
    display: inline-block;
    width: 2.35rem;
    height: 1px;
    background: rgba(211, 172, 114, 0.78);
    content: "";
  }

  .hero-interno__title {
    max-width: 36rem;
    margin: 0;
    color: #fbf9f5;
    font-family: var(--font-heading);
    font-size: var(--tamano-4xl);
    font-weight: 600;
    line-height: 1.05;
    animation: hero-interno-item-in 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 240ms;
  }

  .hero-interno__copy p {
    max-width: 34rem;
    margin: 0;
    color: #b7c0d4;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
    animation: hero-interno-item-in 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 380ms;
  }

  .hero-interno__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  :global(.hero-interno__cta) {
    width: fit-content;
    animation: hero-interno-item-in 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 500ms;
  }

  .hero-interno__actions :global(.hero-interno__cta:nth-child(2)) {
    animation-delay: 600ms;
  }

  @keyframes hero-interno-settle {
    from {
      transform: scale(1.015);
    }

    to {
      transform: scale(1);
    }
  }

  @keyframes hero-interno-item-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 620px) {
    .hero-interno {
      min-height: 28rem;
      padding-top: 5rem;
    }

    .hero-interno__title {
      font-size: clamp(2.35rem, 10vw, 3rem);
    }

    .hero-interno__actions {
      flex-direction: column;
      width: 100%;
    }

    :global(.hero-interno__cta) {
      width: 100%;
    }
  }
</style>
