---
interface IndiceItem {
  id: string;
  etiqueta: string;
}

interface Props {
  indice?: IndiceItem[];
}

const { indice = [] } = Astro.props;
---

<article class="documento-legal">
  <div class="container">
    <div class="documento-legal__columna">
      <div class="documento-legal__aviso reveal">
        <slot name="aviso" />
      </div>

      {
        indice.length > 0 && (
          <nav class="documento-legal__indice reveal" aria-label="Índice de contenidos">
            <span class="documento-legal__indice-titulo">Contenido</span>
            <ol>
              {indice.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.etiqueta}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="documento-legal__cuerpo reveal">
        <slot />
      </div>
    </div>
  </div>
</article>

<style>
  .documento-legal {
    background: var(--color-white);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .documento-legal__columna {
    width: min(40rem, 100%);
    margin-inline: auto;
  }

  .documento-legal__aviso:empty {
    display: none;
  }

  .documento-legal__aviso :global(p) {
    margin: 0 0 clamp(2.25rem, 4vw, 3rem);
    border: 1px solid rgba(191, 145, 73, 0.28);
    border-radius: 12px;
    background: var(--color-ivory);
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
    padding: 1rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.65;
  }

  .documento-legal__indice {
    margin-bottom: clamp(2.5rem, 5vw, 3.25rem);
    border: 1px solid rgba(7, 21, 47, 0.1);
    border-radius: 12px;
    padding: 1.35rem 1.5rem;
  }

  .documento-legal__indice-titulo {
    display: block;
    margin-bottom: 0.85rem;
    color: var(--color-navy);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .documento-legal__indice ol {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: indice;
  }

  .documento-legal__indice li {
    counter-increment: indice;
    font-size: 0.92rem;
  }

  .documento-legal__indice li::before {
    content: counter(indice) ". ";
    color: var(--color-gold);
    font-weight: 700;
  }

  .documento-legal__indice a {
    color: var(--color-navy);
    font-weight: 400;
    transition: color 220ms ease;
  }

  .documento-legal__indice a:hover,
  .documento-legal__indice a:focus-visible {
    color: var(--color-gold);
  }

  .documento-legal__cuerpo {
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.8;
  }

  .documento-legal__cuerpo :global(h2) {
    margin: clamp(2.5rem, 5vw, 3.25rem) 0 1rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: var(--tamano-xl);
    font-weight: 600;
    line-height: 1.25;
    scroll-margin-top: 6.5rem;
  }

  .documento-legal__cuerpo :global(h2:first-child) {
    margin-top: 0;
  }

  .documento-legal__cuerpo :global(h3) {
    margin: 1.85rem 0 0.75rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    scroll-margin-top: 6.5rem;
  }

  .documento-legal__cuerpo :global(p) {
    margin: 0 0 1.15rem;
  }

  .documento-legal__cuerpo :global(ul),
  .documento-legal__cuerpo :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.3rem;
  }

  .documento-legal__cuerpo :global(li) {
    margin-bottom: 0.55rem;
  }

  .documento-legal__cuerpo :global(li)::marker {
    color: var(--color-gold);
  }

  .documento-legal__cuerpo :global(strong) {
    color: var(--color-navy);
    font-weight: 600;
  }

  .documento-legal__cuerpo :global(a) {
    color: var(--color-navy);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(191, 145, 73, 0.5);
    text-underline-offset: 3px;
    transition: color 220ms ease, text-decoration-color 220ms ease;
  }

  .documento-legal__cuerpo :global(a:hover),
  .documento-legal__cuerpo :global(a:focus-visible) {
    color: var(--color-gold);
    text-decoration-color: var(--color-gold);
  }

  @media (max-width: 620px) {
    .documento-legal__cuerpo {
      font-size: 1rem;
    }
  }
</style>
