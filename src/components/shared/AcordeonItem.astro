---
import Icono from "./Icono.astro";

interface Props {
  pregunta: string;
  respuesta: string;
}

const { pregunta, respuesta } = Astro.props;
---

<details class="accordion">
  <summary>
    <span>{pregunta}</span>
    <Icono name="arrowRight" class="accordion__icon" />
  </summary>
  <div class="accordion__content">
    <p>{respuesta}</p>
  </div>
</details>

<style>
  .accordion {
    overflow: hidden;
    border: 1px solid rgba(7, 21, 47, 0.06);
    border-radius: 0.85rem;
    background: var(--color-white);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    padding-inline: 1.35rem;
    color: var(--color-navy);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    list-style: none;
    transition: background-color 220ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: rgba(191, 145, 73, 0.06);
  }

  :global(.accordion__icon) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--color-gold);
    transition: transform 220ms ease;
  }

  details[open] :global(.accordion__icon) {
    transform: rotate(90deg);
  }

  .accordion__content {
    border-top: 1px solid rgba(7, 21, 47, 0.06);
    padding: 1.1rem 1.35rem 1.3rem;
  }

  p {
    max-width: 42rem;
    margin: 0;
    color: rgba(7, 21, 47, 0.68);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.6;
  }
</style>
