---
import Icono from "./Icono.astro";
import { rutas } from "../../config/site";

interface Props {
  pregunta: string;
  respuesta: string;
  mostrarEnlace?: boolean;
  class?: string;
}

const { pregunta, respuesta, mostrarEnlace = false, class: className = "" } = Astro.props;
---

<details class={`accordion ${className}`}>
  <summary>
    <span>{pregunta}</span>
    <Icono name="chevronDown" class="accordion__icon" />
  </summary>
  <div class="accordion__content">
    <p>{respuesta}</p>
    {
      mostrarEnlace && (
        <a class="accordion__link" href={rutas.preguntasFrecuentes}>
          Ver todas las preguntas frecuentes
          <Icono name="arrowRight" class="accordion__link-icon" />
        </a>
      )
    }
  </div>
</details>

<style>
  .accordion {
    overflow: hidden;
    border: 1px solid rgba(7, 21, 47, 0.06);
    border-radius: 0.85rem;
    background: var(--color-white);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    padding-inline: 1.35rem;
    color: var(--color-navy);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    list-style: none;
    transition: background-color 220ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: rgba(191, 145, 73, 0.06);
  }

  :global(.accordion__icon) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--color-gold);
    transition: transform 220ms ease;
  }

  details[open] :global(.accordion__icon) {
    transform: rotate(180deg);
  }

  .accordion__content {
    border-top: 1px solid rgba(7, 21, 47, 0.06);
    padding: 1.1rem 1.35rem 1.3rem;
  }

  p {
    max-width: 42rem;
    margin: 0;
    color: rgba(7, 21, 47, 0.68);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .accordion__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(7, 21, 47, 0.06);
    color: var(--color-navy);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    transition: color 220ms ease;
  }

  .accordion__link:hover,
  .accordion__link:focus-visible {
    color: var(--color-gold);
  }

  :global(.accordion__link-icon) {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 220ms ease;
  }

  .accordion__link:hover :global(.accordion__link-icon),
  .accordion__link:focus-visible :global(.accordion__link-icon) {
    transform: translateX(3px);
  }
</style>
