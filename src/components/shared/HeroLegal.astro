---
interface Props {
  eyebrow?: string;
  titulo: string;
  descripcion?: string;
}

const { eyebrow = "Legal", titulo, descripcion } = Astro.props;
---

<section class="hero-legal" aria-labelledby="hero-legal-title">
  <div class="hero-legal__content">
    <span class="hero-legal__eyebrow">{eyebrow}</span>
    <h1 class="hero-legal__title reveal" id="hero-legal-title">{titulo}</h1>
    {descripcion && <p class="hero-legal__lead reveal">{descripcion}</p>}
  </div>
</section>

<style>
  .hero-legal {
    background: var(--color-ivory);
    padding: clamp(7.5rem, 10vw, 8.75rem) clamp(1.25rem, 4vw, 2.5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-legal__content {
    width: min(44rem, 100%);
    margin-inline: auto;
  }

  .hero-legal__eyebrow {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-legal__title {
    margin: 0 0 1.1rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: var(--tamano-3xl);
    font-weight: 600;
    line-height: 1.12;
  }

  .hero-legal__lead {
    margin: 0;
    max-width: 38rem;
    color: color-mix(in srgb, var(--color-navy) 64%, transparent);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
  }

  @media (max-width: 620px) {
    .hero-legal {
      padding-top: 6.75rem;
    }
  }
</style>
