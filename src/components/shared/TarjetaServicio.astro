---
import Icono from "./Icono.astro";

interface Props {
  titulo: string;
  descripcion: string;
  icono: string;
  href?: string;
  dark?: boolean;
  class?: string;
}

const { titulo, descripcion, icono, href, dark = false, class: className = "" } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag class={`service-card ${dark ? "service-card--dark" : ""} ${className}`} href={href}>
  <Icono name={icono} class="service-card__icon" />
  <h3>{titulo}</h3>
  <p>{descripcion}</p>
</Tag>

<style>
  .service-card {
    display: flex;
    min-height: 15.5rem;
    flex-direction: column;
    gap: 0.9rem;
    border: 1px solid rgba(7, 21, 47, 0.08);
    border-radius: 0.875rem;
    background: var(--color-white);
    padding: clamp(1.55rem, 2.4vw, 1.85rem);
    box-shadow: 0 1px 0 rgba(7, 21, 47, 0.03);
    transition:
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms ease,
      border-color 320ms ease,
      background-color 320ms ease;
  }

  .service-card:hover {
    transform: translateY(-7px);
    border-color: rgba(191, 145, 73, 0.32);
    box-shadow: var(--shadow-card);
  }

  :global(.service-card__icon) {
    width: 3rem;
    height: 3rem;
    color: var(--color-gold);
  }

  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    line-height: 1.15;
  }

  p {
    margin: 0;
    color: color-mix(in srgb, var(--color-navy) 68%, transparent);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.72;
  }

  .service-card--dark {
    min-width: min(20rem, 78vw);
    min-height: 17rem;
    padding: 1.75rem;
    border-color: rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.055);
    color: var(--color-white);
  }

  .service-card--dark :global(.service-card__icon) {
    width: 2rem;
    height: 2rem;
  }

  .service-card--dark:hover {
    border-color: rgba(191, 145, 73, 0.5);
    background: rgba(255, 255, 255, 0.085);
  }

  .service-card--dark p {
    color: rgba(255, 255, 255, 0.62);
  }
</style>
