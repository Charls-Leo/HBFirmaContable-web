---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "md" | "lg";
  surface?: "dark" | "light";
  class?: string;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
  target?: "_blank" | "_self";
  rel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  surface = "dark",
  class: className = "",
  type = "button",
  ariaLabel,
  target,
  rel,
} = Astro.props;

const classes = ["btn", `btn--${variant}`, `btn--${size}`, `btn--surface-${surface}`, className].filter(Boolean).join(" ");
const relValue = rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
---

{
  href ? (
    <a class={classes} href={href} aria-label={ariaLabel} target={target} rel={relValue}>
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.62rem;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 0.7rem;
    font-family: var(--font-body);
    font-weight: 750;
    line-height: 1.1;
    text-align: center;
    transition:
      transform 240ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 240ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 240ms cubic-bezier(0.4, 0, 0.2, 1),
      color 240ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        110deg,
        transparent 0%,
        rgba(255, 255, 255, 0.24) 42%,
        rgba(211, 172, 114, 0.34) 50%,
        transparent 62%
      );
    content: "";
    transform: translateX(-120%);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translateY(-2px);
  }

  .btn:hover::before,
  .btn:focus-visible::before {
    transform: translateX(120%);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn--md {
    min-height: 3.45rem;
    min-width: 12rem;
    padding: 0.9rem 1.65rem;
    font-size: 0.98rem;
  }

  .btn--lg {
    min-height: 4.15rem;
    min-width: 14.75rem;
    padding: 1rem 1.9rem;
    font-size: 1.02rem;
  }

  .btn--primary {
    border-color: rgba(211, 172, 114, 0.7);
    background:
      linear-gradient(135deg, #d3ac72 0%, #bd9257 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 16px 36px rgba(8, 14, 28, 0.24),
      0 0 0 1px rgba(211, 172, 114, 0.14);
    color: #080e1c;
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    border-color: rgba(211, 172, 114, 0.92);
    background:
      linear-gradient(135deg, #d9b87f 0%, #d3ac72 42%, #a67c40 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 18px 40px rgba(211, 172, 114, 0.18),
      0 0 0 1px rgba(236, 220, 190, 0.18);
  }

  .btn--secondary {
    border-color: #0e1830;
    background: #0e1830;
    color: #fbf9f5;
    box-shadow: 0 14px 34px rgba(8, 14, 28, 0.16);
  }

  .btn--secondary:hover,
  .btn--secondary:focus-visible {
    border-color: rgba(211, 172, 114, 0.72);
    background: #142242;
    box-shadow: 0 18px 40px rgba(8, 14, 28, 0.22);
  }

  .btn--outline {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 14px 34px rgba(8, 14, 28, 0.16);
  }

  .btn--outline.btn--surface-dark {
    border-color: rgba(251, 249, 245, 0.34);
    background: rgba(251, 249, 245, 0.045);
    color: #fbf9f5;
    backdrop-filter: blur(8px);
  }

  .btn--outline.btn--surface-dark:hover,
  .btn--outline.btn--surface-dark:focus-visible {
    border-color: rgba(211, 172, 114, 0.72);
    background: rgba(211, 172, 114, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 18px 40px rgba(8, 14, 28, 0.26);
  }

  .btn--outline.btn--surface-light {
    border-color: rgba(23, 29, 43, 0.18);
    background: rgba(255, 255, 255, 0.48);
    color: #0e1830;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.62),
      0 12px 28px rgba(8, 14, 28, 0.08);
  }

  .btn--outline.btn--surface-light:hover,
  .btn--outline.btn--surface-light:focus-visible {
    border-color: rgba(166, 124, 64, 0.48);
    background: rgba(211, 172, 114, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 16px 34px rgba(8, 14, 28, 0.11);
  }

  .btn--ghost {
    border-color: rgba(7, 21, 47, 0.12);
    color: var(--color-navy);
    background: transparent;
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    border-color: rgba(191, 145, 73, 0.42);
    color: var(--color-gold);
  }
</style>
