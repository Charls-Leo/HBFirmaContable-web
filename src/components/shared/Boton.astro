---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "md" | "lg";
  class?: string;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
  target?: "_blank" | "_self";
  rel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
  ariaLabel,
  target,
  rel,
} = Astro.props;

const classes = ["btn", `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(" ");
const relValue = rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
---

{
  href ? (
    <a class={classes} href={href} aria-label={ariaLabel} target={target} rel={relValue}>
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.1;
    text-align: center;
    transition:
      background-color 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms cubic-bezier(0.4, 0, 0.2, 1),
      color 300ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn--md {
    padding: 0.85rem 1.6rem;
    font-size: 0.9375rem;
  }

  .btn--lg {
    padding: 1rem 2.1rem;
    font-size: 1.125rem;
  }

  .btn--primary {
    border-color: rgba(191, 145, 73, 0.3);
    background: var(--color-gold-soft);
    color: var(--color-navy);
    box-shadow: var(--shadow-gold);
  }

  .btn--primary:hover {
    border-color: rgba(191, 145, 73, 0.6);
    background: var(--color-gold);
    box-shadow: 0 18px 40px rgba(191, 145, 73, 0.32);
  }

  .btn--secondary {
    background: var(--color-navy);
    color: var(--color-white);
  }

  .btn--secondary:hover {
    background: var(--color-gold);
    color: var(--color-navy);
  }

  .btn--outline {
    border-color: rgba(255, 255, 255, 0.42);
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.02);
  }

  .btn--outline:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.1);
  }

  .btn--ghost {
    border-color: rgba(7, 21, 47, 0.12);
    color: var(--color-navy);
    background: transparent;
  }

  .btn--ghost:hover {
    border-color: rgba(191, 145, 73, 0.42);
    color: var(--color-gold);
  }
</style>
