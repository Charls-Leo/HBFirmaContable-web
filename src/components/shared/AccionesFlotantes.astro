---
import { rutas, site } from "../../config/site";
import { getEnlaceWhatsapp } from "../../utils/whatsapp";
import Icono from "./Icono.astro";
import IconoWhatsapp from "./IconoWhatsapp.astro";
---

<div class="floating-actions" aria-label="Acciones rápidas">
  <a href={rutas.contacto} class="floating-actions__item" aria-label={`Contactar con ${site.nombre}`}>
    <span>Contacto</span>
    <Icono name="mail" />
  </a>
  <a
    href={getEnlaceWhatsapp()}
    class="floating-actions__item floating-actions__item--whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
  >
    <span>WhatsApp</span>
    <IconoWhatsapp class="floating-actions__whatsapp-icon" />
  </a>
</div>

<style>
  .floating-actions {
    position: fixed;
    right: calc(clamp(1.5rem, 3vw, 2rem) + env(safe-area-inset-right, 0px));
    bottom: calc(clamp(1.5rem, 3vw, 2rem) + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: grid;
    gap: 0.9rem;
  }

  .floating-actions__item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    color: var(--color-white);
    animation: float-y 3.6s ease-in-out infinite;
  }

  .floating-actions__item--whatsapp {
    animation-delay: 1.1s;
  }

  .floating-actions__item span {
    border-radius: 999px;
    background: var(--color-navy);
    padding: 0.62rem 0.82rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    opacity: 0;
    text-transform: uppercase;
    transform: translateX(0.45rem);
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  .floating-actions__item:hover span,
  .floating-actions__item:focus-visible span {
    opacity: 1;
    transform: translateX(0);
  }

  .floating-actions__item :global(svg) {
    width: 3.75rem;
    height: 3.75rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-navy);
    padding: 1.05rem;
    box-shadow: 0 18px 38px rgba(7, 21, 47, 0.24);
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 260ms ease;
  }

  .floating-actions__item:hover :global(svg),
  .floating-actions__item:focus-visible :global(svg) {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 24px 48px rgba(7, 21, 47, 0.32);
  }

  .floating-actions__item--whatsapp span {
    background: #25d366;
    color: var(--color-white);
  }

  .floating-actions__item--whatsapp :global(svg) {
    background: #25d366;
    box-shadow: 0 18px 38px rgba(37, 211, 102, 0.32);
  }

  .floating-actions__item--whatsapp:hover :global(svg),
  .floating-actions__item--whatsapp:focus-visible :global(svg) {
    box-shadow: 0 22px 44px rgba(37, 211, 102, 0.4);
  }

  @media (max-width: 760px) {
    .floating-actions {
      right: calc(1rem + env(safe-area-inset-right, 0px));
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
      gap: 0.75rem;
    }

    .floating-actions__item {
      animation: none;
    }

    .floating-actions__item span {
      display: none;
    }

    .floating-actions__item :global(svg) {
      width: 3.4rem;
      height: 3.4rem;
      padding: 0.95rem;
    }
  }
</style>
