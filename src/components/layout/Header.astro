---
import { rutas } from "../../config/site";
import Logo from "../shared/Logo.astro";
import Icono from "../shared/Icono.astro";
import NavegacionPrincipal from "./NavegacionPrincipal.astro";
import MenuMovil from "./MenuMovil.astro";
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={rutas.inicio} aria-label="HB Presentar, ir al inicio">
      <Logo tone="light" class="site-header__logo site-header__logo--light" />
      <Logo tone="dark" class="site-header__logo site-header__logo--dark" />
    </a>

    <div class="site-header__desktop">
      <NavegacionPrincipal />
      <a class="site-header__cta" href={rutas.contacto}>Agendar una cita</a>
    </div>

    <button class="site-header__menu" type="button" aria-label="Abrir menú" aria-controls="mobile-panel" aria-expanded="false" data-menu-open>
      <Icono name="menu" />
    </button>
  </div>
</header>

<MenuMovil />

<script>
  const header = document.querySelector("#site-header");
  const menu = document.querySelector("#mobile-panel");
  const openButton = document.querySelector("[data-menu-open]");
  const closeButtons = document.querySelectorAll("[data-menu-close], #mobile-panel a");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const hasDarkHero = document.querySelector(".hero, .hero-interno");

  const syncHeader = () => {
    header?.classList.toggle("is-scrolled", !hasDarkHero || window.scrollY > 88);
  };

  const setMenu = (isOpen) => {
    menu?.classList.toggle("is-open", isOpen);
    menu?.setAttribute("aria-hidden", String(!isOpen));
    openButton?.setAttribute("aria-expanded", String(isOpen));
    document.body.classList.toggle("menu-open", isOpen);
  };

  syncHeader();
  window.addEventListener("scroll", syncHeader, { passive: true });
  openButton?.addEventListener("click", () => setMenu(true));
  closeButtons.forEach((button) => button.addEventListener("click", () => setMenu(false)));
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  if (!reduceMotion) {
    header?.classList.add("has-entered");
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    color: #fbf9f5;
    transition:
      background-color 320ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 320ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 620ms cubic-bezier(0.16, 1, 0.3, 1),
      color 320ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header.has-entered {
    animation: header-enter 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes header-enter {
    from {
      transform: translateY(-100%);
    }
  }

  .site-header.is-scrolled {
    border-bottom-color: rgba(23, 29, 43, 0.12);
    background: rgba(251, 249, 245, 0.92);
    box-shadow: 0 18px 38px rgba(8, 14, 28, 0.07);
    color: #171d2b;
    backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    width: min(1280px, 100%);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-inline: auto;
    padding: clamp(1rem, 2vw, 1.35rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .site-header__brand {
    position: relative;
    display: block;
    flex: 0 0 auto;
  }

  :global(.site-header__logo) {
    width: auto;
    height: 4.75rem;
    max-height: 4.75rem;
    object-fit: contain;
    transition: opacity 420ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.site-header__logo--dark) {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .site-header.is-scrolled :global(.site-header__logo--light) {
    opacity: 0;
  }

  .site-header.is-scrolled :global(.site-header__logo--dark) {
    opacity: 1;
  }

  .site-header__desktop {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__cta {
    position: relative;
    z-index: 0;
    display: inline-flex;
    overflow: hidden;
    min-width: 11.75rem;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(251, 249, 245, 0.46);
    border-radius: 0.5rem;
    background: rgba(251, 249, 245, 0.04);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    color: #fbf9f5;
    padding: 0.88rem 1.4rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      transform 320ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 320ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 320ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 320ms cubic-bezier(0.4, 0, 0.2, 1),
      color 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header__cta::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        105deg,
        transparent 0%,
        rgba(211, 172, 114, 0.28) 38%,
        rgba(255, 255, 255, 0.18) 50%,
        transparent 64%
      );
    content: "";
    transform: translateX(-115%);
    transition: transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header__cta:hover,
  .site-header__cta:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(211, 172, 114, 0.76);
    background: rgba(211, 172, 114, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(251, 249, 245, 0.18),
      0 16px 38px rgba(8, 14, 28, 0.22);
  }

  .site-header__cta:hover::before,
  .site-header__cta:focus-visible::before {
    transform: translateX(115%);
  }

  .site-header.is-scrolled .site-header__cta {
    border-color: #0e1830;
    background: #0e1830;
    box-shadow: 0 12px 28px rgba(8, 14, 28, 0.12);
    color: #fbf9f5;
  }

  .site-header.is-scrolled .site-header__cta:hover,
  .site-header.is-scrolled .site-header__cta:focus-visible {
    border-color: rgba(140, 106, 53, 0.72);
    background: #142242;
    box-shadow: 0 16px 34px rgba(23, 29, 43, 0.16);
  }

  .site-header__menu {
    display: none;
    width: 2.95rem;
    height: 2.95rem;
    place-items: center;
    border: 1px solid rgba(251, 249, 245, 0.34);
    border-radius: 999px;
    background: rgba(251, 249, 245, 0.05);
    color: inherit;
    transition:
      background-color 320ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header.is-scrolled .site-header__menu {
    border-color: rgba(23, 29, 43, 0.16);
    background: rgba(255, 255, 255, 0.32);
  }

  .site-header__menu :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  @media (max-width: 1040px) {
    .site-header__desktop {
      display: none;
    }

    .site-header__menu {
      display: grid;
    }

    .site-header__inner {
      padding: 1rem 1.25rem;
    }
  }
</style>
