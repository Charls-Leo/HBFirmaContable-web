---
import { navegacionPrincipal } from "../../data/navegacion";

interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const currentPath = Astro.url.pathname;
const normalize = (href: string) => (href === "/" ? "/" : href.replace(/\/$/, ""));
const current = normalize(currentPath);
---

<nav class={mobile ? "nav nav--mobile" : "nav"} aria-label="Navegación principal">
  {
    navegacionPrincipal.map((item) => (
      <a class:list={["nav__link", normalize(item.href) === current && "is-active"]} href={item.href} aria-current={normalize(item.href) === current ? "page" : undefined}>
        {item.etiqueta}
      </a>
    ))
  }
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.1rem);
  }

  .nav__link {
    position: relative;
    padding-block: 0.32rem;
    color: inherit;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav__link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-gold);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  .nav__link.is-active {
    color: var(--color-gold);
  }

  .nav--mobile {
    display: grid;
    gap: 0.35rem;
  }

  .nav--mobile .nav__link {
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    padding: 1rem 0;
    color: var(--color-white);
    font-size: 0.98rem;
    letter-spacing: 0.08em;
    white-space: normal;
  }
</style>
