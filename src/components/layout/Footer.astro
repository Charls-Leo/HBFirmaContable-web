---
import { site, rutas } from "../../config/site";
import { navegacionFooter, navegacionLegal } from "../../data/navegacion";
import { servicios } from "../../data/servicios";
import Logo from "../shared/Logo.astro";
import Icono from "../shared/Icono.astro";
import IconoWhatsapp from "../shared/IconoWhatsapp.astro";
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand reveal">
        <a href={rutas.inicio} aria-label="Ir al inicio">
          <Logo tone="dark" />
        </a>
        <p>{site.descripcion}</p>
      </div>

      <nav aria-label="Navegación del pie de página" class="reveal">
        <h2>Navegación</h2>
        <ul>
          {navegacionFooter.map((item) => <li><a href={item.href}>{item.etiqueta}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Servicios destacados" class="reveal">
        <h2>Servicios</h2>
        <ul>
          {servicios.slice(0, 4).map((item) => <li><a href={item.href}>{item.tituloFooter ?? item.titulo}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Legal" class="reveal">
        <h2>Legal</h2>
        <ul>
          {navegacionLegal.map((item) => <li><a href={item.href}>{item.etiqueta}</a></li>)}
        </ul>
      </nav>

      <div class="footer__contact reveal">
        <h2>Contacto</h2>
        <ul>
          <li>
            <span class="footer__contact-static">
              <IconoWhatsapp />
              <span>{site.whatsappDisplay}</span>
            </span>
          </li>
          <li>
            <span class="footer__contact-static">
              <Icono name="mail" />
              <span>{site.correo}</span>
            </span>
          </li>
          <li>
            <span class="footer__contact-static">
              <Icono name="clock" />
              <span>{site.horario}</span>
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {site.anio} {site.nombre} | Todos los derechos reservados</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ivory);
    color: rgba(7, 21, 47, 0.68);
    padding: clamp(4rem, 8vw, 6rem) 0 2rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(15rem, 1.35fr) repeat(4, minmax(7.5rem, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .footer__brand :global(img) {
    width: 10rem;
    margin-bottom: 1.6rem;
  }

  .footer__brand p {
    max-width: 23rem;
    margin: 0;
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.75;
  }

  h2 {
    margin: 0 0 1.45rem;
    color: var(--color-navy);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 0.86rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    font-size: 0.9rem;
    font-weight: 300;
    transition: color 220ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-gold);
  }

  .footer__contact ul {
    gap: 1rem;
  }

  .footer__contact a,
  .footer__contact-static {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .footer__contact :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    margin-top: 0.15rem;
    color: var(--color-gold);
  }

  .footer__grid > .reveal:nth-child(1) {
    transition-delay: 0ms;
  }

  .footer__grid > .reveal:nth-child(2) {
    transition-delay: 60ms;
  }

  .footer__grid > .reveal:nth-child(3) {
    transition-delay: 120ms;
  }

  .footer__grid > .reveal:nth-child(4) {
    transition-delay: 180ms;
  }

  .footer__grid > .reveal:nth-child(5) {
    transition-delay: 240ms;
  }

  .footer__bottom {
    border-top: 1px solid rgba(7, 21, 47, 0.09);
    padding-top: 1.5rem;
  }

  .footer__bottom p {
    margin: 0;
    color: var(--color-navy);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
