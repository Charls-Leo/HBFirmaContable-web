---
import NavegacionPrincipal from "./NavegacionPrincipal.astro";
import Boton from "../shared/Boton.astro";
import Logo from "../shared/Logo.astro";
import Icono from "../shared/Icono.astro";
import { rutas } from "../../config/site";
---

<div class="mobile-panel" id="mobile-panel" aria-hidden="true">
  <div class="mobile-panel__backdrop" data-menu-close></div>
  <aside class="mobile-panel__sheet" aria-label="Menú móvil">
    <div class="mobile-panel__top">
      <a href={rutas.inicio} class="mobile-panel__logo" aria-label="Ir al inicio">
        <Logo tone="light" />
      </a>
      <button class="mobile-panel__close" type="button" aria-label="Cerrar menú" data-menu-close>
        <Icono name="close" />
      </button>
    </div>
    <NavegacionPrincipal mobile />
    <Boton href={rutas.contacto} class="mobile-panel__cta">Agendar una cita</Boton>
  </aside>
</div>

<style>
  .mobile-panel {
    position: fixed;
    inset: 0;
    z-index: 120;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-panel.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-panel__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 10, 24, 0.58);
    opacity: 0;
    transition: opacity 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-panel__sheet {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    width: min(24rem, 88vw);
    height: 100%;
    flex-direction: column;
    gap: 1.75rem;
    background: #080e1c;
    color: var(--color-white);
    padding: 1.15rem 1.3rem 2rem;
    transform: translateX(100%);
    transition: transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-panel.is-open .mobile-panel__backdrop {
    opacity: 1;
  }

  .mobile-panel.is-open .mobile-panel__sheet {
    transform: translateX(0);
  }

  .mobile-panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mobile-panel__logo :global(img) {
    width: 10rem;
  }

  .mobile-panel__close {
    display: grid;
    width: 2.55rem;
    height: 2.55rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    background: transparent;
    color: var(--color-white);
  }

  .mobile-panel__close :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  :global(.mobile-panel__cta) {
    width: 100%;
    margin-top: auto;
  }
</style>
