---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Cómo trabajamos" showFloatingActions={false}>
  <section class="placeholder">
    <div class="container">
      <span class="eyebrow">Próximamente</span>
      <h1 class="heading">Cómo trabajamos</h1>
      <p class="lead">Esta página quedará desarrollada en la siguiente etapa.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder {
    min-height: 62vh;
    padding-top: 9rem;
    background: var(--color-ivory);
  }
</style>
